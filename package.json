{
  "name": "israel-mcp",
  "version": "0.1.0",
  "description": "MCP server for Israeli services: data.gov.il, Bank of Israel, Hebcal (Jewish calendar / business days), Green Invoice (Morning)",
  "type": "module",
  "bin": {
    "israel-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "start:http": "node dist/http.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
