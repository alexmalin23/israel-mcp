# israel-mcp configuration. Every variable is optional:
# with none set, the four public services (data.gov.il, Registrar of Companies, Bank of Israel, Hebcal) run as-is.

# --- Green Invoice (Morning) — enables gi_* tools when both keys are set ---
GREENINVOICE_API_ID=
GREENINVOICE_API_SECRET=
# sandbox | production (separate tenancies, separate keys)
GREENINVOICE_ENV=sandbox
# true registers gi_create_document (two-step: dryRun preview → confirmationToken → issue)
GREENINVOICE_ALLOW_WRITE=false
# Refuse documents whose lines or payments exceed this (document currency). 0 disables the cap.
GREENINVOICE_MAX_TOTAL=20000

# --- Hebcal ---
# GeoNames id for Shabbat times (281184 = Jerusalem, 293397 = Tel Aviv, 294801 = Haifa)
HEBCAL_DEFAULT_GEONAMEID=281184

# --- Networking ---
HTTP_TIMEOUT_MS=15000

# --- Streamable HTTP entrypoint only (npm run start:http) ---
PORT=3000
HOST=127.0.0.1
